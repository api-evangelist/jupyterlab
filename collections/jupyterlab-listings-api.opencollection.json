{
  "opencollection": "1.0.0",
  "info": {
    "name": "JupyterLab Server REST Licenses Listings API",
    "version": "2.27.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Listings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JupyterLab Get extension listings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8888/lab/api/listings/@jupyterlab/extensionmanager-extension/listings.json"
          },
          "docs": "Returns the extension manager listings (allowed and blocked extensions)."
        }
      ]
    }
  ],
  "bundled": true
}
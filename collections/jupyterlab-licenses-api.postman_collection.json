            },
            "url": {
              "path": [
                "licenses"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bundles",
                  "value": "<string>",
                  "description": "Comma-separated list of bundles to include in the report."
                },
                {
                  "disabled": false,
                  "key": "full_text",
                  "value": "<boolean>",
                  "description": "Whether to include the full text of each license."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>"
